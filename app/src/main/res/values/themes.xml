<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TwelvePits" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Starting theme: a plain solid #070504 window, an invisible system splash on Android 12+. -->
    <style name="Theme.TwelvePits.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.TwelvePits</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
